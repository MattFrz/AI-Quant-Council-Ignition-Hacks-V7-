# Copy to .env and fill in. Never commit .env.

# ---- LLM (pick ONE provider for the whole project, per plan section 7) ------
LLM_PROVIDER=openai
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Hard ceiling in USD. The client refuses further calls once exceeded.
LLM_BUDGET_USD=40.0

# ---- SEC EDGAR -------------------------------------------------------------
# EDGAR REJECTS requests without a real name and email here. Not optional.
SEC_USER_AGENT=AI Quant Council mattfarzaneh21@gmail.com

# ---- Universe / data -------------------------------------------------------
UNIVERSE_SIZE=1000
MIN_MARKET_CAP=1000000000
MIN_ADV_USD=5000000
DATA_CACHE_DIR=data/cache
FIXTURES_DIR=data/fixtures

# ---- Backtest defaults -----------------------------------------------------
BACKTEST_START=2015-01-01
BACKTEST_END=2024-12-31
BENCHMARK_TICKER=SPY
COMMISSION_BPS=1.0
MAX_POSITION_PCT=5.0
MAX_ADV_PARTICIPATION=0.05

# ---- Runtime ---------------------------------------------------------------
LOG_LEVEL=INFO
OFFLINE_MODE=false
FRONTEND_ORIGIN=http://localhost:3000
EXTRA_CORS_ORIGINS=https://your-app.base44.app
